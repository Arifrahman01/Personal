<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_capture"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_quick_capture_short"
        android:shortcutLongLabel="@string/shortcut_quick_capture_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="id.personal.hub.personal_hub"
            android:targetClass="id.personal.hub.personal_hub.MainActivity">
            <extra
                android:name="shortcut_id"
                android:value="quick_capture" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
